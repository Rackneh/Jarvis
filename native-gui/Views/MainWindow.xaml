<Window x:Class="JarvisDeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JarvisDeck.Views"
        xmlns:controls="clr-namespace:JarvisDeck.Controls"
        Title="JARVIS // Holographic Command Deck V2"
        Height="820" Width="1360" MinHeight="660" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VoidBgBrush}"
        FontFamily="Segoe UI">

  <Window.Resources>
    <DataTemplate x:Key="TaskCardTemplate">
      <Border Background="#A60B1526" BorderBrush="#3322D3EE" BorderThickness="1"
              CornerRadius="8" Padding="10" Margin="0,0,0,8" Tag="{Binding Id}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}"
                       FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="#0E1420"
                    BorderBrush="#223047" BorderThickness="1">
              <TextBlock Text="{Binding Status}" FontSize="10" FontFamily="Consolas">
                <TextBlock.Foreground>
                  <Binding Path="StatusColor" Converter="{StaticResource BrushConverter}" />
                </TextBlock.Foreground>
              </TextBlock>
            </Border>
          </Grid>
          <ProgressBar Style="{StaticResource ProgressBarNeon}" Minimum="0" Maximum="100"
                       Value="{Binding Progress, Mode=OneWay}" Margin="0,7,0,4" />
          <TextBlock Text="{Binding LastStep}" FontFamily="Consolas" FontSize="10.5"
                     Foreground="{StaticResource Dim}" TextWrapping="Wrap" MaxHeight="44" />
          <Border Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}"
                  Background="#2A2110" CornerRadius="6" Padding="8" Margin="0,7,0,0"
                  BorderBrush="{StaticResource Amber}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="TASK NEEDS YOUR ANSWER" FontSize="10" FontFamily="Consolas"
                         Foreground="{StaticResource Amber}" Effect="{StaticResource AmberGlow}" />
              <TextBlock Text="{Binding PendingQuestion}" FontSize="11.5" TextWrapping="Wrap"
                         Foreground="{StaticResource Text}" Margin="0,4" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AnswerBox" Style="{StaticResource NeonInput}" FontSize="11.5"
                         Text="{Binding AnswerDraft, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Answer" Style="{StaticResource NeonBtnMagenta}"
                        Margin="6,0,0,0" Tag="{Binding Id}" Click="OnAnswerTask" />
              </Grid>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
            <Button Content="Report" Style="{StaticResource NeonBtn}" FontSize="10.5" Padding="8,3" Margin="0,0,5,0"
                    Tag="{Binding Id}" Click="OnTaskReport" />
            <Button Content="Pause" Style="{StaticResource NeonBtn}" FontSize="10.5" Padding="8,3" Margin="0,0,5,0"
                    Tag="{Binding Id}" Click="OnTaskPause" />
            <Button Content="Resume" Style="{StaticResource NeonBtn}" FontSize="10.5" Padding="8,3" Margin="0,0,5,0"
                    Tag="{Binding Id}" Click="OnTaskResume" />
            <Button Content="Cancel" Style="{StaticResource NeonBtn}" FontSize="10.5" Padding="8,3"
                    Tag="{Binding Id}" Click="OnTaskCancel" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Full-Window Layer 0: 3D Jarvis Core & Background System Effects Stage -->
    <controls:JarvisCore3DView x:Name="Core3D" Grid.RowSpan="3" />

    <!-- Top Command Bar -->
    <Border Grid.Row="0" Style="{StaticResource HoloWingCard}" Background="{StaticResource GlassHeaderBrush}"
            Margin="10,10,10,4" Padding="14,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource Red}"
                 Effect="{StaticResource RedGlow}" VerticalAlignment="Center" Margin="0,0,10,0" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="NameText" Text="JARVIS" FontSize="20" FontWeight="Bold"
                     Foreground="{StaticResource Cyan}" Effect="{StaticResource CyanGlow}" />
          <Border Background="#2222D3EE" BorderBrush="#6622D3EE" BorderThickness="1"
                  CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="V2.0 3D CORE" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold"
                       Foreground="{StaticResource Cyan}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ProviderBadge" Text="provider: —" FontFamily="Consolas"
                     FontSize="11.5" Foreground="{StaticResource Purple}" VerticalAlignment="Center"
                     Effect="{StaticResource PurpleGlow}" Margin="0,0,14,0" />
          <Border Background="#1EFACC15" BorderBrush="#66FACC15" BorderThickness="1"
                  CornerRadius="5" Padding="8,3" VerticalAlignment="Center"
                  Cursor="Hand" MouseLeftButtonUp="OnToggleCacheClick"
                  ToolTip="Click to toggle TTS Cache ON / OFF">
            <TextBlock x:Name="CacheBadge" Text="cache: standby" FontFamily="Consolas"
                       FontSize="11" Foreground="{StaticResource Gold}" />
          </Border>
        </StackPanel>

        <Button x:Name="BtnCoreFocus" Grid.Column="4" Content="CORE VIEW" Style="{StaticResource NeonBtnGhost}"
                Margin="4,0" Click="OnToggleCoreFocus" ToolTip="Fade side HUD panels to inspect the 3D Core and live background effects" />
        <Button x:Name="BtnFxDemo" Grid.Column="5" Content="FX PULSE" Style="{StaticResource NeonBtnAmber}"
                Margin="4,0" Click="OnTriggerFxDemo" ToolTip="Trigger a holographic system telemetry pulse cascade" />
        <Button x:Name="BtnSfx" Grid.Column="6" Content="SFX ON" Style="{StaticResource NeonBtn}"
                Margin="4,0" Click="OnToggleSfx" ToolTip="Toggle futuristic HUD sound effects" />
        <Button x:Name="BtnReasoning" Grid.Column="7" Content="THINK OFF" Style="{StaticResource NeonBtn}"
                Margin="4,0" Click="OnToggleReasoning" ToolTip="Toggle Conscious/Jarvis foreground reasoning (chain-of-thought)" />
        <Button x:Name="BtnDory" Grid.Column="8" Content="DORY" Style="{StaticResource NeonBtn}"
                Margin="4,0" Click="OnSwitchDory" />
        <Button x:Name="BtnLms" Grid.Column="9" Content="LM STUDIO" Style="{StaticResource NeonBtn}"
                Margin="4,0" Click="OnSwitchLms" />
        <Button x:Name="BtnMic" Grid.Column="10" Content="MIC ON" Style="{StaticResource NeonBtn}"
                Margin="4,0" Click="OnToggleMic" />
        <Button Grid.Column="11" Content="SETTINGS" Style="{StaticResource NeonBtnMagenta}"
                Margin="4,0,0,0" Click="OnOpenSettings" />
      </Grid>
    </Border>

    <!-- Middle 3-Column Holographic Stage -->
    <Grid Grid.Row="1" Margin="4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="375" />
      </Grid.ColumnDefinitions>

      <!-- Left Holographic Wing: Conscious Neural Stream & Audio Waveforms -->
      <Border x:Name="LeftWing" Grid.Column="0" Style="{StaticResource HoloWingCard}" Margin="6,4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Margin="0,0,0,8">
            <Grid>
              <TextBlock Text="CONSCIOUS NEURAL LINK" Style="{StaticResource Title}" FontSize="12.5" />
              <TextBlock Text="LIVE STREAM" FontFamily="Consolas" FontSize="9.5"
                         Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="StateText" Text="IDLE — listening for the wake word"
                       FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Text}" Margin="0,4,0,1" />
            <TextBlock x:Name="EngineText" Text="engines: —" FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource Dim}" />
          </StackPanel>

          <Border Grid.Row="1" Background="#99070E1A" BorderBrush="#2A22D3EE"
                  BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,8">
            <StackPanel>
              <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="YOU" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" Effect="{StaticResource GreenGlow}"
                           VerticalAlignment="Center" />
                <Canvas x:Name="UserWave" Grid.Column="1" Height="24" ClipToBounds="True" />
              </Grid>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="JARVIS" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                           Foreground="{StaticResource Blue}" Effect="{StaticResource BlueGlow}"
                           VerticalAlignment="Center" />
                <Canvas x:Name="AiWave" Grid.Column="1" Height="24" ClipToBounds="True" />
              </Grid>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="MIC" FontSize="9.5" FontFamily="Consolas" FontWeight="SemiBold"
                           Foreground="{StaticResource Gray}" Effect="{StaticResource GrayGlow}"
                           VerticalAlignment="Center" />
                <Canvas x:Name="AmbientWave" Grid.Column="1" Height="24" ClipToBounds="True" />
              </Grid>
            </StackPanel>
          </Border>

          <ScrollViewer x:Name="ConsciousScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConsciousStream" Margin="0,0,4,0" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Center Open 3D Core Viewport Zone (transparent to mouse so user can orbit the 3D Core) -->
      <Grid Grid.Column="1" IsHitTestVisible="False">
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,10"
                Background="#99060E1B" BorderBrush="#3322D3EE" BorderThickness="1"
                CornerRadius="10" Padding="14,7" MaxWidth="520">
          <StackPanel>
            <TextBlock x:Name="CoreSubStatusText" Text="HOLOGRAPHIC TELEMETRY // DRAG CORE TO ORBIT"
                       FontFamily="Consolas" FontSize="9.5" Foreground="{StaticResource Cyan}"
                       HorizontalAlignment="Center" Opacity="0.8" />
            <TextBlock x:Name="CoreSubtitleText" Text="Awaiting voice or command input…"
                       FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource Text}"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Right Holographic Wing: Subconscious Tasks & Live System Activity Matrix -->
      <Border x:Name="RightWing" Grid.Column="2" Style="{StaticResource HoloWingCard}" Margin="6,4">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1.15*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>

          <!-- Subconscious Task Matrix -->
          <Grid Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="SUBCONSCIOUS TASK MATRIX" Style="{StaticResource Title}" FontSize="12.5" />
              <TextBlock x:Name="ProfileProgress" Text="onboarding: —" FontFamily="Consolas" FontSize="10"
                         Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0">
              <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}"
                            ItemTemplate="{StaticResource TaskCardTemplate}" />
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TaskObjective" Style="{StaticResource NeonInput}" FontSize="11.5"
                       KeyDown="OnTaskObjectiveKey" />
              <Button Grid.Column="1" Content="Spawn Task" Style="{StaticResource NeonBtnMagenta}"
                      Margin="6,0,0,0" Click="OnSpawnTask" />
            </Grid>
          </Grid>

          <!-- Separator -->
          <Border Grid.Row="1" Height="1" Background="#3322D3EE" Margin="0,10,0,8" />

          <!-- Live System Activity Matrix -->
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <TextBlock Text="LIVE SYSTEM ACTIVITY MATRIX" Style="{StaticResource Title}" FontSize="12" />
              <TextBlock Text="ALL TELEMETRY" FontFamily="Consolas" FontSize="9.5"
                         Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer x:Name="SystemEventScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SystemEventStream" Margin="0,0,4,0" />
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom Command Console -->
    <Border Grid.Row="2" Style="{StaticResource HoloWingCard}" Background="{StaticResource GlassHeaderBrush}"
            Margin="10,4,10,10" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnPtt" Content="PTT VOICE" Style="{StaticResource NeonBtnAmber}"
                Margin="0,0,8,0" Click="OnTogglePtt" ToolTip="Toggle Push-to-Talk voice capture" />
        <TextBox x:Name="ChatInput" Grid.Column="1" Style="{StaticResource NeonInput}"
                 KeyDown="OnChatKey" />
        <Button x:Name="BtnSend" Grid.Column="2" Content="SEND COMMAND" Style="{StaticResource NeonBtn}"
                Margin="8,0,0,0" Click="OnSend" />
      </Grid>
    </Border>
  </Grid>
</Window>
