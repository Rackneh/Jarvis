<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette -->
  <Color x:Key="BgColor">#0A0E17</Color>
  <Color x:Key="PanelColor">#101724</Color>
  <Color x:Key="CyanColor">#22D3EE</Color>
  <Color x:Key="BlueColor">#3B82F6</Color>
  <Color x:Key="GrayColor">#9CA3AF</Color>
  <Color x:Key="MagentaColor">#F472B6</Color>
  <Color x:Key="PurpleColor">#A78BFA</Color>
  <Color x:Key="GreenColor">#4ADE80</Color>
  <Color x:Key="RedColor">#F87171</Color>
  <Color x:Key="AmberColor">#FBBF24</Color>
  <Color x:Key="GoldColor">#FACC15</Color>
  <Color x:Key="TextColor">#C7D2E0</Color>
  <Color x:Key="DimColor">#5B6B85</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
  <SolidColorBrush x:Key="Gray" Color="{StaticResource GrayColor}" />
  <SolidColorBrush x:Key="Magenta" Color="{StaticResource MagentaColor}" />
  <SolidColorBrush x:Key="Purple" Color="{StaticResource PurpleColor}" />
  <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
  <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
  <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
  <SolidColorBrush x:Key="PanelBorder" Color="#223047" />
  <RadialGradientBrush x:Key="VoidBgBrush" Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.72" RadiusY="0.72">
    <GradientStop Color="#0D1D36" Offset="0.0" />
    <GradientStop Color="#070E1C" Offset="0.48" />
    <GradientStop Color="#03060E" Offset="1.0" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="GlassPanelBrush" Color="#B808111F" />
  <SolidColorBrush x:Key="GlassHeaderBrush" Color="#CC0B172A" />
  <SolidColorBrush x:Key="HoloBorderBrush" Color="#4422D3EE" />

  <DropShadowEffect x:Key="CyanGlow" Color="{StaticResource CyanColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
  <DropShadowEffect x:Key="BlueGlow" Color="{StaticResource BlueColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
  <DropShadowEffect x:Key="GrayGlow" Color="{StaticResource GrayColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
  <DropShadowEffect x:Key="MagentaGlow" Color="{StaticResource MagentaColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
  <DropShadowEffect x:Key="PurpleGlow" Color="{StaticResource PurpleColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
  <DropShadowEffect x:Key="AmberGlow" Color="{StaticResource AmberColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
  <DropShadowEffect x:Key="GoldGlow" Color="{StaticResource GoldColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.85" />
  <DropShadowEffect x:Key="RedGlow" Color="{StaticResource RedColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
  <DropShadowEffect x:Key="GreenGlow" Color="{StaticResource GreenColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />

  <Style x:Key="HudCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HoloBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="6" />
  </Style>

  <Style x:Key="HoloWingCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HoloBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#22D3EE" BlurRadius="22" ShadowDepth="0" Opacity="0.18" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Cyan}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Effect" Value="{StaticResource CyanGlow}" />
  </Style>

  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="NeonBtn" TargetType="Button">
    <Setter Property="Background" Value="#141C2C" />
    <Setter Property="Foreground" Value="{StaticResource Cyan}" />
    <Setter Property="BorderBrush" Value="{StaticResource Cyan}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Effect" Value="{StaticResource CyanGlow}" />
              <Setter TargetName="b" Property="Background" Value="#1B2740" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#223150" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeonBtnMagenta" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
    <Setter Property="Foreground" Value="{StaticResource Magenta}" />
    <Setter Property="BorderBrush" Value="{StaticResource Magenta}" />
  </Style>

  <Style x:Key="NeonBtnAmber" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
    <Setter Property="Foreground" Value="{StaticResource Amber}" />
    <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
    <Setter Property="Background" Value="#1E180B" />
  </Style>

  <Style x:Key="NeonBtnGhost" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="#3322D3EE" />
    <Setter Property="Background" Value="#550A1424" />
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#4422D3EE" CornerRadius="3" Margin="1" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeonInput" TargetType="TextBox">
    <Setter Property="Background" Value="#0E1420" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource Cyan}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="NeonComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="Black" />
  </Style>

  <Style x:Key="NeonCombo" TargetType="ComboBox">
    <Setter Property="Background" Value="#0E1420" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource NeonComboItem}" />
  </Style>

  <Style x:Key="ProgressBarNeon" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="#0E1420" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Cyan}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
            <Border x:Name="PART_Track" CornerRadius="3">
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                      CornerRadius="3" HorizontalAlignment="Left" Effect="{StaticResource CyanGlow}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
